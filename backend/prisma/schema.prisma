// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuário do sistema ────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(OPERATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  labels       Label[]
  sessions     UserSession[]
  createdRules ShelfLifeRule[] @relation("RuleCreatedBy")

  @@map("users")
}

// Uma sessão por aparelho. Guarda só o hash do refresh token; o anterior vale por alguns segundos
// para duas abas que renovam juntas.
model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @map("token_hash")
  previousHash String?   @map("previous_hash")
  rotatedAt    DateTime? @map("rotated_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

enum UserRole {
  ADMIN
  OPERATOR
}

// ── Produto (insumo cadastrado) ───────────────────────────
model Product {
  id                      String   @id @default(uuid())
  name                    String
  brand                   String
  category                String?
  daysValidRefrigerated   Int      @default(0) @map("days_valid_refrigerated")
  daysValidFrozen         Int      @default(0) @map("days_valid_frozen")
  unit                    String?                                             // kg, L, un, etc.
  notes                   String?
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  labels Label[]
  lots   ProductLot[]
  shelfLifeRules ShelfLifeRule[]

  @@index([name])
  @@index([brand])
  @@index([createdAt])
  @@map("products")
}

// ── Lote recebido: guarda a validade do fabricante ───────
model ProductLot {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  code       String
  expiryDate DateTime @map("expiry_date") @db.Date
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  labels  Label[]

  @@index([productId, active, expiryDate])
  @@map("product_lots")
}

// ── Etiqueta gerada ──────────────────────────────────────
model Label {
  id               String          @id @default(uuid())
  shortCode        String          @unique @map("short_code")
  productId        String          @map("product_id")
  userId           String          @map("user_id")
  lot              String
  lotId            String?         @map("lot_id")                    // nulo: validade informada na hora
  openedAt         DateTime        @map("opened_at") @db.Date
  discardAt        DateTime        @map("discard_at") @db.Date
  storageType      StorageType     @map("storage_type")
  storageTemp      String          @map("storage_temp")              // texto impresso; nas novas, gerado pelo servidor ("4,0 °C")
  storageTemperature Decimal?      @map("storage_temperature") @db.Decimal(4, 1) // nulo nas antigas sem texto numérico
  ruleId           String?         @map("rule_id")
  ruleVersion      Int?            @map("rule_version")
  ruleSource       String?         @map("rule_source")               // cópia da fonte da regra usada
  shelfLifeDays    Int             @map("shelf_life_days")
  originalExpiryDate DateTime      @map("original_expiry_date") @db.Date
  cappedByOriginalExpiry Boolean   @default(false) @map("capped_by_original_expiry")
  productName      String          @map("product_name")
  productBrand     String          @map("product_brand")
  responsibleName  String?         @map("responsible_name")
  requestId        String?         @map("request_id")                // repetir o envio devolve a mesma etiqueta
  printedAt        DateTime?       @map("printed_at")
  printCount       Int             @default(0) @map("print_count")
  createdAt        DateTime        @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  rule    ShelfLifeRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  productLot ProductLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@unique([userId, requestId])
  @@index([productId])
  @@index([userId])
  @@index([discardAt])
  @@index([createdAt])
  @@index([ruleId])
  @@index([lotId])
  @@map("labels")
}

// Regra imutável: editar cria uma nova versão e desativa a anterior. Nunca é apagada.
model ShelfLifeRule {
  id                String         @id @default(uuid())
  productId         String?        @map("product_id")
  category          String?
  storageType       StorageType    @map("storage_type")
  shelfLifeDays     Int            @map("shelf_life_days")
  minTemperature    Decimal?       @map("min_temperature") @db.Decimal(5, 2)
  maxTemperature    Decimal?       @map("max_temperature") @db.Decimal(5, 2)
  sourceType        RuleSourceType @map("source_type")
  source            String
  observation       String?
  validatedByName   String?        @map("validated_by_name") // responsável técnico; pode não ser usuário
  validatedAt       DateTime?      @map("validated_at") @db.Date
  createdById       String?        @map("created_by_id")
  version           Int            @default(1)
  previousVersionId String?        @unique @map("previous_version_id")
  active            Boolean        @default(true)
  deactivatedAt     DateTime?      @map("deactivated_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  product         Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy       User?          @relation("RuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  previousVersion ShelfLifeRule? @relation("RuleVersions", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion     ShelfLifeRule? @relation("RuleVersions")
  labels          Label[]

  @@index([productId, storageType, active])
  @@index([category, storageType, active])
  @@map("shelf_life_rules")
}

enum RuleSourceType {
  NORMA_LEGAL
  REFERENCIA_TECNICA
  FABRICANTE
  PROCEDIMENTO_INTERNO
}

enum StorageType {
  REFRIGERADO
  CONGELADO
}
