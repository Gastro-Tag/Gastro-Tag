NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://gastrotag:gastrotag_secret@localhost:5432/gastrotag
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:5173
KITCHEN_TIME_ZONE=America/Manaus
CAP_DISCARD_TO_ORIGINAL_EXPIRY=true
# Proxies confiáveis à frente da API: 0 sem proxy; 1 atrás do nginx do Docker.
TRUST_PROXY_HOPS=0
