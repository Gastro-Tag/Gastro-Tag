# Copie para .env.test. Use SOMENTE um banco descartável: os testes de integração criam e apagam linhas.
# Banco sugerido: docker run -d --name gastrotag-test-db -e POSTGRES_USER=gastrotag -e POSTGRES_PASSWORD=test -e POSTGRES_DB=gastrotag_test -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgresql://gastrotag:test@localhost:5433/gastrotag_test
JWT_ACCESS_SECRET=test-access-secret-with-at-least-32-chars
JWT_REFRESH_SECRET=test-refresh-secret-with-at-least-32-chars
NODE_ENV=test
KITCHEN_TIME_ZONE=America/Manaus
CAP_DISCARD_TO_ORIGINAL_EXPIRY=true
