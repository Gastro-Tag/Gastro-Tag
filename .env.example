# Banco de dados
POSTGRES_USER=gastrotag
POSTGRES_PASSWORD=
POSTGRES_DB=gastrotag

# Segredos JWT: gere dois valores aleatórios diferentes, com pelo menos 32 caracteres
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Admin inicial opcional. Sem ambos, a API não cria uma conta administrativa.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API e frontend
KITCHEN_TIME_ZONE=America/Manaus
# Regra padrão conservadora: limitar descarte à validade do fabricante
CAP_DISCARD_TO_ORIGINAL_EXPIRY=true
CORS_ORIGIN=http://localhost
