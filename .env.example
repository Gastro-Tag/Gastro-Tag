# Banco de dados
POSTGRES_USER=gastrotag
POSTGRES_PASSWORD=
POSTGRES_DB=gastrotag

# Backup automático (serviço "backup"; guia em scripts/README.md)
# Horário do dump diário (HH:MM, fuso America/Manaus) e quantos arquivos manter
BACKUP_HORARIO=03:00
BACKUP_RETENCAO=14

# Segredos JWT: gere dois valores aleatórios diferentes, com pelo menos 32 caracteres
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Admin inicial opcional. Sem ambos, a API não cria uma conta administrativa.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Só cria o admin se a conta não existir. true: a cada início, volta senha, perfil ADMIN e conta ativa
# para os valores acima (use só para recuperar o acesso e depois volte para false).
ADMIN_SYNC_ON_BOOT=false

# API e frontend
KITCHEN_TIME_ZONE=America/Manaus
# Regra padrão conservadora: limitar descarte à validade do fabricante
CAP_DISCARD_TO_ORIGINAL_EXPIRY=true
# Quantos dias para trás a data de abertura pode ir
MAX_BACKDATE_DAYS=2
CORS_ORIGIN=http://localhost
